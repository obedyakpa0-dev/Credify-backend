# Production Backend Environment Configuration
NODE_ENV=production
PORT=5000

# Database Connection (using docker container service name)
MONGO_URI=mongodb://mongodb:27017/credify_prod

# JWT & Encryption Secrets (REPLACE WITH VERY STRONG UNIQUE SECRETS IN PRODUCTION)
JWT_SECRET=production-jwt-secret-replace-with-secure-key-32-chars-min
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Allowed CORS Origins (comma separated list of domain URLs)
CORS_ORIGIN=https://yourdomain.com,http://localhost:80

# Payment Integration Settings
PAYMENT_PROVIDER=manual
PAYMENT_CURRENCY=GHS
PAYMENT_CALLBACK_URL=https://yourdomain.com/api/payments/callback
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=sk_live_replace_me
PAYSTACK_PUBLIC_KEY=pk_live_replace_me
PAYSTACK_WEBHOOK_SECRET=whsec_replace_me

# SMTP Email Configuration
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@yourdomain.com
SMTP_PASS=your-smtp-password
EMAIL_FROM=no-reply@yourdomain.com

# Frontend URL
FRONTEND_URL=https://yourdomain.com
