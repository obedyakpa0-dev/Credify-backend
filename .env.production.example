NODE_ENV=production
PORT=5000
MONGO_URI=mongodb+srv://<db-user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=<generate-a-unique-random-secret-at-least-32-characters>
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
CORS_ORIGIN=https://your-frontend.example.com
PAYMENT_PROVIDER=paystack
PAYMENT_CURRENCY=GHS
CERTIFICATE_PRICE=<certificate-price-in-GHS>
PAYMENT_CALLBACK_URL=https://your-api.example.com/api/payments/callback
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=<paystack-secret-key>
PAYSTACK_PUBLIC_KEY=<paystack-public-key>
PAYSTACK_WEBHOOK_SECRET=<paystack-webhook-secret>
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-password>
EMAIL_FROM=no-reply@yourdomain.com
FRONTEND_URL=https://your-frontend.example.com
